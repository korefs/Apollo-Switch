<brls:Box
    width="170"
    height="230"
    axis="column"
    alignItems="stretch"
    focusable="true"
    cornerRadius="@style/apollo/card_radius"
    highlightCornerRadius="20"
    backgroundColor="@theme/apollo/surface">

    <brls:Image
        id="image"
        width="auto"
        height="auto"
        grow="1"
        scalingType="fill"
        cornerRadius="@style/apollo/card_radius"
        backgroundColor="#00000030"/>

    <brls:Box
        detachedX="0"
        detachedY="0"
        width="162"
        height="230"
        axis="column"
        direction="rightToLeft"
        justifyContent="flexStart"
        alignItems="stretch">

        <brls:Image
            id="favorite_app_image"
            width="28"
            height="28"
            marginTop="8"
            alpha="0.75"
            image="@res/img/star.png"
            scalingType="stretch"/>

        <brls:Image
            id="current_app_image"
            width="28"
            height="28"
            marginTop="8"
            alpha="0.75"
            image="@res/img/play.png"
            scalingType="stretch"/>
    </brls:Box>

    <brls:Rectangle
        id="unactive_layer"
        detachedX="0"
        detachedY="0"
        width="170"
        height="230"
        color="#4A4A4AA0"
        cornerRadius="@style/apollo/card_radius"/>

    <brls:Box
        detachedX="0"
        detachedY="0"
        width="170"
        height="230"
        axis="column"
        justifyContent="flexEnd">

        <brls:Box
            width="auto"
            height="auto"
            minHeight="34"
            axis="column"
            justifyContent="center"
            backgroundColor="@theme/brls/backdrop"
            padding="8"
            cornerRadius="@style/apollo/card_radius">

            <brls:Label
                id="title"
                width="auto"
                height="auto"
                horizontalAlign="center"
                fontSize="16"/>

        </brls:Box>

    </brls:Box>

</brls:Box>
