<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0" >
        
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">
            
            <brls:Header
                id="header"
                title="Host"
                paddingBottom="@style/apollo/space_s"/>

            <brls:Header
                title="PLAY"
                lineBottom="0"
                paddingTop="@style/apollo/space_m"/>
                
            <brls:DetailCell
                id="connect"
                backgroundColor="@theme/apollo/surface"
                cornerRadius="@style/apollo/card_radius"/>

            <brls:Header
                title="HOST SETTINGS"
                lineBottom="0"
                paddingTop="@style/apollo/space_l"/>

            <brls:DetailCell
                id="stream_profiles"/>
                
            <brls:DetailCell
                id="remove"
                lineTop="1px"
                marginTop="@style/apollo/space_m"/>
                  
        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
