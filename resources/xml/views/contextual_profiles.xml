<brls:Box width="auto" height="auto">
    <brls:ScrollingFrame width="auto" height="auto" axis="column"
                         alignItems="stretch" grow="1.0">
        <brls:Box width="10000" height="auto" axis="column"
                  alignItems="stretch"
                  paddingTop="@style/brls/tab_details/padding_top"
                  paddingRight="@style/brls/tab_details/padding_right"
                  paddingBottom="@style/brls/tab_details/padding_bottom"
                  paddingLeft="@style/brls/tab_details/padding_left">
            <brls:Header title="@i18n/contextual_profiles/title"
                         subtitle="@i18n/contextual_profiles/description"
                         lineBottom="0"/>
            <brls:DetailCell id="handheld"/>
            <brls:DetailCell id="docked"/>
            <brls:Header id="summary" paddingTop="@style/apollo/space_l"/>
            <brls:BooleanCell id="enabled"/>
            <brls:BooleanCell id="bitrate_override"/>
            <brls:Header id="bitrate_header"
                         title="@i18n/settings/video_bitrate"
                         paddingTop="40"/>
            <brls:Slider id="bitrate_slider" height="84" grow="1"/>
            <brls:SelectorCell id="codec"/>
            <brls:SelectorCell id="mapping_layout"/>
        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
